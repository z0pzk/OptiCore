<Window x:Class="OptiCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiCore — Системный оптимизатор" Height="680" Width="980"
        MinHeight="560" MinWidth="840"
        Background="#0F1117" Foreground="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Status Bar -->
        <Border Grid.Row="0" Background="#181B24" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="OptiCore v1.3" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtGameStatus" Text="Игра не обнаружена — режим ожидания" FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="TxtRamHeader" Text="RAM: 0% (0 / 0 МБ)" FontSize="13" FontWeight="SemiBold" Foreground="#60A5FA"/>
                    <ProgressBar x:Name="RamProgress" Width="220" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#3B82F6" Background="#2D3343" BorderThickness="0" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" x:Name="BadgePower" Background="#1F2937" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPowerMode" Text="CPU: Средний режим" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#181B24" CornerRadius="6,6,0,0" Margin="0,0,6,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="Главная">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RAM Card -->
                        <Border Grid.Column="0" Background="#181B24" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Очистка памяти (Mem Reduct 3 стиль)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Сброс рабочего набора процессов, системного кэша и Standby-списка." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <Button Content="Очистить RAM сейчас" Click="BtnCleanRam_Click" Margin="0,0,0,12"/>

                                <CheckBox x:Name="ChkAutoClean" Content="Авто-очистка при достижении порога" Foreground="#E5E7EB" FontSize="12" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                                    <TextBlock Text="Порог:" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="SliderThreshold" Width="180" Minimum="50" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True" Value="80" ValueChanged="SliderThreshold_ValueChanged"/>
                                    <TextBlock x:Name="TxtThreshold" Text="80%" Foreground="#60A5FA" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <CheckBox x:Name="ChkAutostart" Content="Запускать с Windows (свёрнутым в трей, без UAC)" Foreground="#E5E7EB" FontSize="12" Checked="ChkAutostart_Changed" Unchecked="ChkAutostart_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- CPU & Freeze Card -->
                        <Border Grid.Column="2" Background="#181B24" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Игровой режим (CPU + Таймер + Заморозка)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Разблокировка ядер, точный таймер 0.5 мс, высокий приоритет и заморозка фона." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Игровой режим" Background="#10B981" Click="BtnGameModeOn_Click" Margin="0,0,8,0"/>
                                    <Button Content="Средний режим" Background="#374151" Click="BtnGameModeOff_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Заморозить фон" Background="#D97706" Click="BtnFreezeNow_Click" Margin="0,0,8,0"/>
                                    <Button Content="Разморозить всё" Background="#4B5563" Click="BtnUnfreezeAll_Click"/>
                                </StackPanel>

                                <CheckBox x:Name="ChkAutoGameMode" Content="Авто-режим при запуске игры из списка" Foreground="#E5E7EB" FontSize="12" Margin="0,0,0,4" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
                                <CheckBox x:Name="ChkHighPriority" Content="Ставить игре высокий приоритет (High)" Foreground="#E5E7EB" FontSize="12" Margin="0,0,0,4" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
                                <CheckBox x:Name="ChkTimerRes" Content="Точный таймер Windows (0.5 мс в играх)" Foreground="#E5E7EB" FontSize="12" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Activity Log -->
                    <Border Grid.Row="1" Background="#181B24" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Журнал действий" FontSize="13" FontWeight="Bold" Foreground="#E5E7EB" Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" x:Name="LstLog" Background="#0F1117" Foreground="#9CA3AF" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="6"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: BUILT-IN TASK MANAGER -->
            <TabItem Header="Диспетчер процессов">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#181B24" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Сортировка:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbSort" Width="210" SelectedIndex="0" SelectionChanged="CmbSort_SelectionChanged" Margin="0,0,12,0">
                                    <ComboBoxItem Content="Жрёт больше всего RAM"/>
                                    <ComboBoxItem Content="Жрёт больше всего CPU"/>
                                    <ComboBoxItem Content="По имени (А-Я)"/>
                                </ComboBox>
                                <Button Content="Обновить" Padding="12,6" Click="BtnRefreshProcs_Click" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkAutoRefreshProcs" Content="Автообновление (пауза при выборе)" Foreground="#9CA3AF" VerticalAlignment="Center" IsChecked="True"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtProcActionStatus" Text="Выбери процесс в таблице" Foreground="#60A5FA" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="GridProcesses" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Background="#181B24" Foreground="#F3F4F6"
                              RowBackground="#141720" AlternatingRowBackground="#181B24"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#232836"
                              HeadersVisibility="Column" BorderThickness="0"
                              SelectionChanged="GridProcesses_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#141720"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                                <Setter Property="Padding" Value="0,4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1F2937"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1F2430"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Процесс" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                            <DataGridTextColumn Header="RAM (МБ)" Binding="{Binding RamMb}" Width="110"/>
                            <DataGridTextColumn Header="CPU (%)" Binding="{Binding CpuPercent}" Width="95"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#181B24" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                        <WrapPanel>
                            <Button Content="Заморозить" Background="#D97706" Padding="10,6" Margin="0,0,6,0" Click="BtnProcFreeze_Click"/>
                            <Button Content="Разморозить" Background="#4B5563" Padding="10,6" Margin="0,0,6,0" Click="BtnProcUnfreeze_Click"/>
                            <Button Content="+ В заморозку фона" Background="#B45309" Padding="10,6" Margin="0,0,6,0" Click="BtnProcAddFreeze_Click"/>
                            <Button Content="+ В белый список" Background="#2563EB" Padding="10,6" Margin="0,0,6,0" Click="BtnProcAddWhite_Click"/>
                            <Button Content="+ В игры" Background="#059669" Padding="10,6" Margin="0,0,6,0" Click="BtnProcAddGame_Click"/>
                            <Button Content="Завершить (Kill)" Background="#DC2626" Padding="10,6" Click="BtnProcKill_Click"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: WINDOWS TWEAKS -->
            <TabItem Header="Твики Windows">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#181B24" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="«Рекомендуемые» применяют только безопасные твики. Оранжевые [Осторожно] включай вручную по желанию."
                                       Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Применить рекомендуемые" Background="#10B981" Padding="12,7" Margin="0,0,8,0" Click="BtnApplyAllTweaks_Click"/>
                                <Button Content="Сбросить все на стандарт" Background="#DC2626" Padding="12,7" Click="BtnRestoreTweaks_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Gaming, Network & Input -->
                            <Border Grid.Column="0" Background="#181B24" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Игры, сеть и отклик (Безопасные)" FontSize="14" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,10"/>

                                    <CheckBox x:Name="TwkGameDvr" Content="Отключить GameDVR и фоновую запись Xbox" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    <CheckBox x:Name="TwkFse" Content="Отключить Fullscreen Optimizations (меньше инпут-лаг)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    <CheckBox x:Name="TwkHags" Content="Аппаратное планирование GPU (HAGS — нужен рестарт)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    <CheckBox x:Name="TwkScheduler" Content="Приоритет игр в планировщике CPU и GPU" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    <CheckBox x:Name="TwkPowerThrottle" Content="Отключить Power Throttling (душение частот)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    <CheckBox x:Name="TwkNetThrottle" Content="Отключить сетевой троттлинг (NetworkThrottlingIndex)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    <CheckBox x:Name="TwkNagle" Content="Отключить алгоритм Нейгла (TCPNoDelay — ниже пинг)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    <CheckBox x:Name="TwkMouseAccel" Content="Отключить ускорение мыши (точность 1:1 в играх)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    <CheckBox x:Name="TwkKeyboard" Content="Убрать задержку отклика клавиатуры" Foreground="#E5E7EB" Margin="0,0,0,4" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Column: System + Risky/Caveat -->
                            <StackPanel Grid.Column="2">
                                <Border Background="#181B24" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Службы и интерфейс (Безопасные)" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>

                                        <CheckBox x:Name="TwkSearch" Content="Отключить индексацию поиска Windows (WSearch)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkSysMain" Content="Отключить SysMain / Superfetch (разгрузка RAM и диска)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkTelemetry" Content="Отключить службу телеметрии (DiagTrack)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkBgApps" Content="Запретить фоновую работу UWP-приложений" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkTransparency" Content="Отключить эффекты прозрачности Windows" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkMenuDelay" Content="Убрать задержку открытия меню (MenuShowDelay = 0)" Foreground="#E5E7EB" Margin="0,0,0,9" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkShutdown" Content="Ускорить закрытие зависших программ при выключении" Foreground="#E5E7EB" Margin="0,0,0,4" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Aggressive / Undesirable Tweaks -->
                                <Border Background="#261C15" BorderBrush="#D97706" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Нежелательные / с оговорками [Осторожно]" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,8"/>

                                        <CheckBox x:Name="TwkHibernate" Content="[Осторожно] Отключить гибернацию (уберёт сон/быстрый старт)" Foreground="#FDE68A" Margin="0,0,0,8" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkClipboard" Content="[Осторожно] Отключить историю буфера обмена (Win+V)" Foreground="#FDE68A" Margin="0,0,0,8" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkWer" Content="[Осторожно] Отключить отчёты об ошибках (WerSvc)" Foreground="#FDE68A" Margin="0,0,0,8" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                        <CheckBox x:Name="TwkXbox" Content="[Осторожно] Отключить Xbox-службы (сломает игры MS Store!)" Foreground="#FCA5A5" Margin="0,0,0,2" Checked="TwkChanged" Unchecked="TwkChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 4: PROCESS LISTS -->
            <TabItem Header="Списки правил">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Games List -->
                    <Border Grid.Column="0" Background="#181B24" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Игры (триггеры)" FontSize="13" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock Grid.Row="1" Text="Имя процесса без .exe" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                            <ListBox Grid.Row="2" x:Name="LstGames" Background="#0F1117" Foreground="#F3F4F6" BorderThickness="0" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="3">
                                <TextBox x:Name="TxtNewGame" Background="#0F1117" Foreground="White" BorderBrush="#374151" Padding="6" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Добавить" Padding="10,6" Click="BtnAddGame_Click" Margin="0,0,6,0"/>
                                    <Button Content="Удалить" Background="#DC2626" Padding="10,6" Click="BtnDelGame_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Freeze Targets List -->
                    <Border Grid.Column="2" Background="#181B24" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Замораживать в фоне" FontSize="13" FontWeight="Bold" Foreground="#FBBF24"/>
                            <TextBlock Grid.Row="1" Text="Имя процесса без .exe" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                            <ListBox Grid.Row="2" x:Name="LstFreeze" Background="#0F1117" Foreground="#F3F4F6" BorderThickness="0" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="3">
                                <TextBox x:Name="TxtNewFreeze" Background="#0F1117" Foreground="White" BorderBrush="#374151" Padding="6" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Добавить" Padding="10,6" Click="BtnAddFreeze_Click" Margin="0,0,6,0"/>
                                    <Button Content="Удалить" Background="#DC2626" Padding="10,6" Click="BtnDelFreeze_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Whitelist -->
                    <Border Grid.Column="4" Background="#181B24" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Белый список (не трогать)" FontSize="13" FontWeight="Bold" Foreground="#60A5FA"/>
                            <TextBlock Grid.Row="1" Text="Discord, Telegram и нужные" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                            <ListBox Grid.Row="2" x:Name="LstWhitelist" Background="#0F1117" Foreground="#F3F4F6" BorderThickness="0" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="3">
                                <TextBox x:Name="TxtNewWhite" Background="#0F1117" Foreground="White" BorderBrush="#374151" Padding="6" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Добавить" Padding="10,6" Click="BtnAddWhite_Click" Margin="0,0,6,0"/>
                                    <Button Content="Удалить" Background="#DC2626" Padding="10,6" Click="BtnDelWhite_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
