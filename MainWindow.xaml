<Window x:Class="OptiCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiCore — Системный оптимизатор" Height="600" Width="880"
        MinHeight="520" MinWidth="780"
        Background="#0F1117" Foreground="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Status Bar -->
        <Border Grid.Row="0" Background="#181B24" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="OptiCore v1.0" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtGameStatus" Text="Игра не обнаружена — режим ожидания" FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="TxtRamHeader" Text="RAM: 0% (0 / 0 МБ)" FontSize="13" FontWeight="SemiBold" Foreground="#60A5FA"/>
                    <ProgressBar x:Name="RamProgress" Width="220" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#3B82F6" Background="#2D3343" BorderThickness="0" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" x:Name="BadgePower" Background="#1F2937" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPowerMode" Text="CPU: Средний режим" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#181B24" CornerRadius="6,6,0,0" Margin="0,0,6,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="Главная и управление">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Memory & Power Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RAM Card -->
                        <Border Grid.Column="0" Background="#181B24" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Очистка памяти (Mem Reduct 3 стиль)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Сброс рабочего набора процессов, системного кэша и Standby-списка." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <Button Content="Очистить RAM сейчас" Click="BtnCleanRam_Click" Margin="0,0,0,12"/>

                                <CheckBox x:Name="ChkAutoClean" Content="Авто-очистка при достижении порога" Foreground="#E5E7EB" FontSize="12" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Порог:" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="SliderThreshold" Width="180" Minimum="50" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True" Value="80" ValueChanged="SliderThreshold_ValueChanged"/>
                                    <TextBlock x:Name="TxtThreshold" Text="80%" Foreground="#60A5FA" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- CPU & Freeze Card -->
                        <Border Grid.Column="2" Background="#181B24" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Игровой режим (Процессор + Заморозка)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Разблокировка парковки ядер CPU и заморозка фоновых процессов." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Игровой режим" Background="#10B981" Click="BtnGameModeOn_Click" Margin="0,0,8,0"/>
                                    <Button Content="Средний режим" Background="#374151" Click="BtnGameModeOff_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Заморозить фон" Background="#D97706" Click="BtnFreezeNow_Click" Margin="0,0,8,0"/>
                                    <Button Content="Разморозить всё" Background="#4B5563" Click="BtnUnfreezeAll_Click"/>
                                </StackPanel>

                                <CheckBox x:Name="ChkAutoGameMode" Content="Автоматически включать при запуске игры из списка" Foreground="#E5E7EB" FontSize="12" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Activity Log -->
                    <Border Grid.Row="2" Background="#181B24" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Журнал действий" FontSize="13" FontWeight="Bold" Foreground="#E5E7EB" Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" x:Name="LstLog" Background="#0F1117" Foreground="#9CA3AF" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="6"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: PROCESS LISTS -->
            <TabItem Header="Списки процессов и Игры">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Games List -->
                    <Border Grid.Column="0" Background="#181B24" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Игры (триггеры)" FontSize="13" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock Grid.Row="1" Text="Имя процесса без .exe" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                            <ListBox Grid.Row="2" x:Name="LstGames" Background="#0F1117" Foreground="#F3F4F6" BorderThickness="0" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="3">
                                <TextBox x:Name="TxtNewGame" Background="#0F1117" Foreground="White" BorderBrush="#374151" Padding="6" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Добавить" Padding="10,6" Click="BtnAddGame_Click" Margin="0,0,6,0"/>
                                    <Button Content="Удалить" Background="#DC2626" Padding="10,6" Click="BtnDelGame_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Freeze Targets List -->
                    <Border Grid.Column="2" Background="#181B24" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Замораживать в фоне" FontSize="13" FontWeight="Bold" Foreground="#FBBF24"/>
                            <TextBlock Grid.Row="1" Text="Имя процесса без .exe" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                            <ListBox Grid.Row="2" x:Name="LstFreeze" Background="#0F1117" Foreground="#F3F4F6" BorderThickness="0" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="3">
                                <TextBox x:Name="TxtNewFreeze" Background="#0F1117" Foreground="White" BorderBrush="#374151" Padding="6" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Добавить" Padding="10,6" Click="BtnAddFreeze_Click" Margin="0,0,6,0"/>
                                    <Button Content="Удалить" Background="#DC2626" Padding="10,6" Click="BtnDelFreeze_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Whitelist -->
                    <Border Grid.Column="4" Background="#181B24" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Белый список (не трогать)" FontSize="13" FontWeight="Bold" Foreground="#60A5FA"/>
                            <TextBlock Grid.Row="1" Text="Discord, Telegram и нужные" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,8"/>
                            <ListBox Grid.Row="2" x:Name="LstWhitelist" Background="#0F1117" Foreground="#F3F4F6" BorderThickness="0" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="3">
                                <TextBox x:Name="TxtNewWhite" Background="#0F1117" Foreground="White" BorderBrush="#374151" Padding="6" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Добавить" Padding="10,6" Click="BtnAddWhite_Click" Margin="0,0,6,0"/>
                                    <Button Content="Удалить" Background="#DC2626" Padding="10,6" Click="BtnDelWhite_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
